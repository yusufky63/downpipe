{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downpipe",
  "version": "0.2.0",
  "identifier": "dev.downpipe.desktop",
  "build": {
    "beforeDevCommand": "pnpm sidecar && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm sidecar && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Downpipe",
        "width": 1180,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/downpipe-native-host"],
    "windows": {
      "nsis": {
        "installerHooks": "./installer-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": ["./browser-bridge.wxs"],
        "componentGroupRefs": ["DownpipeBrowserBridgeCleanup"]
      }
    },
    "shortDescription": "Adaptive, resumable download manager",
    "license": "Apache-2.0"
  }
}
